.memory-logs/

# CSL test fixtures (downloaded on first test run)
tests/.csl-fixtures/

# vitest coverage reports
coverage/

# Claude Code
.claude

# Internal Docs
docs/

# Local note-editor checkout (not tracked as a submodule)
note-editor/note-editor/
